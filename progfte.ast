<PROGRAMA>
  [PROG: rafi]
  [ID: PruebaErrores]
  <DECLARACIONES>
    [DECL: decl]
    <DECLARACION>
      [TIPO: entero]
      [ID: a]
      [ID: b]
      [PC: ;]
  [INICIO: inicio]
  <SENTENCIAS>
    <ASIGNACION>
      [ID: a]
      [ASIG: :=]
      <EXPRESION>
        <TERMINO>
          [CENT: 5]
      [PC: ;]
    <ASIGNACION>
      [ID: b]
      [ASIG: :=]
      <EXPRESION>
        <TERMINO>
          [CENT: 2]
      [PC: ;]
    <IMPRESION>
